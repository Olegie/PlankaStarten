# Console application example: BMI with a guard result.
# V0 = weight in kg, V1 = height in cm.

P810 bmi_value (V0[:32.16], V1[:32.16]) => R0[:32.16]
(V1[:32.16] / 100[:32.16]) => Z1[:32.16]
(Z1[:32.16] * Z1[:32.16]) => Z2[:32.16]
(V0[:32.16] / Z2[:32.16]) => R0[:32.16]
END

P811 bmi_guard (V0[:32.16], V1[:32.16]) => R0[:32.16], R1[:1.1]
0[:1.1] => R1[:1.1]
(V1[:32.16] = 0[:32.16]) => 1[:1.1] => R1[:1.1]
(V1[:32.16] = 0[:32.16]) => 0[:32.16] => R0[:32.16]
(V1[:32.16] > 0[:32.16]) => bmi_value(V0[:32.16], V1[:32.16]) => R0[:32.16]
END

P812 start (V0[:32.16], V1[:32.16]) => R0[:32.16], R1[:1.1]
bmi_guard(V0[:32.16], V1[:32.16]) => R0[:32.16], R1[:1.1]
END
